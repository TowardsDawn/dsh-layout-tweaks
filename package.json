{
  "name": "dsh-layout-tweaks",
  "version": "0.2.4",
  "description": "DSH Web GUI 布局微调：会话头上边栏拆成两行、侧栏功能入口并入可折叠块。纯渲染层实现，不修改任何其他插件，新插件入口自动归位。 · Layout tweaks for the DSH Web GUI: a two-row session header and entry modules folded into a collapsible block.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "client-plugin",
    "layout",
    "sidebar",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
