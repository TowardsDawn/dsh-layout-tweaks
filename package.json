{
  "name": "dsh-layout-tweaks",
  "version": "0.4.1",
  "description": "DSH Web GUI 布局微调：会话头上边栏拆成两行、左侧栏面板列表一键折叠、底栏入口两行排布。纯渲染层实现，不修改任何其他插件。 · Layout tweaks for the DSH Web GUI: a two-row session header, a collapsible sidebar panel list, and a two-row footer layout.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "client-plugin",
    "layout",
    "sidebar",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
